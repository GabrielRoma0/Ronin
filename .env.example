# Projeto Supabase de produção/staging (ver Fase 0 do plano de produção).
# Copie este arquivo para .env.local e preencha com os valores reais —
# .env.local nunca é commitado (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "secret key" (service role) do Supabase — acesso total ao banco, ignora
# RLS. NUNCA prefixo NEXT_PUBLIC_. Usada só em lib/supabase/admin.ts pra
# resolver username -> e-mail no login (ver lib/actions/auth.ts).
SUPABASE_SECRET_KEY=

# Só usada no servidor (nunca prefixo NEXT_PUBLIC_) — leitura automática da
# foto da nota fiscal via IA (ver lib/actions/notaFoto.ts). Sem essa chave,
# a aba "Foto da nota" continua visível mas mostra erro ao tentar ler.
ANTHROPIC_API_KEY=
